# Copy to .env.local for local development. Never commit .env.local.
# In Vercel, set these under Project → Settings → Environment Variables.

# --- Public -------------------------------------------------------------
# Dr. Sarpong's Sanity project (sanity.io/manage). While this is blank the site
# shows the starter content from content/seed.ts.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-10-01

# Canonical URL used for metadata, sitemap and robots.txt (no trailing slash).
# Set this in Vercel's *Production* environment only, e.g. https://www.nanosarpongmd.com
NEXT_PUBLIC_SITE_URL=

# --- Secret (server-only; never prefix with NEXT_PUBLIC_) -----------------
# Viewer token for draft previews. sanity.io/manage → API → Tokens → Add API token (Viewer).
SANITY_API_READ_TOKEN=

# Shared secret for /api/revalidate (Sanity webhook) and /api/refresh-publications.
# Generate with: openssl rand -hex 32
SANITY_REVALIDATE_SECRET=

# Only needed once, locally, to run `npm run seed` (Editor token). Do not add to Vercel.
SANITY_API_WRITE_TOKEN=
